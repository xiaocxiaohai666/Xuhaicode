{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 service",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/service",
            "args": ["service.conf"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
